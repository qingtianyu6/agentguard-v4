# Backend database (default local SQLite, no external service required)
DATABASE_URL=sqlite:///./agentguard.db
# Frontend
VITE_API_BASE=http://127.0.0.1:8000

# P2C-V V3 extractor (offline by default)
AGENTGUARD_EXTRACTOR=auto
