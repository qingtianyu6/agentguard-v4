# Default zero-config database
DATABASE_URL=sqlite:///./agentguard.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://agentguard:agentguard@localhost:5432/agentguard

# P2C-V V3 extractor (offline by default)
AGENTGUARD_EXTRACTOR=auto
# Optional OpenAI-compatible / Ollama v1 endpoint
# AGENTGUARD_LLM_BASE_URL=http://127.0.0.1:11434/v1
# AGENTGUARD_LLM_MODEL=qwen3:8b
# AGENTGUARD_LLM_API_KEY=

# Explicit isolation profile: sandbox retains V3 demonstration behavior.
# strict requires distinct gateway and approver secrets, and reviewed active contracts.
# AGENTGUARD_SECURITY_PROFILE=strict
# AGENTGUARD_GATEWAY_TOKEN=replace-with-long-random-secret
# AGENTGUARD_APPROVER_TOKEN=replace-with-different-long-random-secret
# AGENTGUARD_CEDAR_CLI=/opt/cedar/bin/cedar
